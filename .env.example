# Copie para .env e preencha. NUNCA comite o .env (repo público).

# Diretório de dados (jobs, SQLite, blobs)
CLEANROOM_DATA_DIR=./data

# Browserless / Chrome remoto via CDP (inclui token)
CLEANROOM_BROWSER_WS_ENDPOINT=ws://<browserless-host>:<port>?token=<token>

# LLM: openai | anthropic | gemini | openai-compatible | fake (testes)
CLEANROOM_LLM_PROVIDER=fake
CLEANROOM_LLM_MODEL=
CLEANROOM_LLM_API_KEY=
CLEANROOM_LLM_BASE_URL=

# Serviço
CLEANROOM_HTTP_PORT=4870
CLEANROOM_API_TOKEN=<gerar-token-forte>
CLEANROOM_MAX_CONCURRENT_JOBS=1
CLEANROOM_LOG_LEVEL=info

# Fase 2: handoff, inbox, credenciais
CLEANROOM_NOTIFY_WEBHOOK_URL=
CLEANROOM_PUBLIC_URL=
CLEANROOM_INBOX_DOMAIN=lab.example.com
CLEANROOM_INBOX_HMAC_SECRET=<gerar-segredo>
CLEANROOM_CREDENTIALS_KEY=<32-bytes-base64>
